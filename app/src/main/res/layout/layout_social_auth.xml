<?xml version="1.0" encoding="utf-8"?>
<!-- "or continue with" divider + Google / Microsoft buttons. Shared by Login and Sign Up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/met_divider" />

        <TextView
            android:id="@+id/textSocialDivider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_m"
            android:text="@string/or_continue_with"
            android:textAppearance="@style/TextAppearance.MET.Caption" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/met_divider" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoogle"
            style="@style/Widget.MET.Button.Social"
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/google"
            app:icon="@drawable/ic_google"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMicrosoft"
            style="@style/Widget.MET.Button.Social"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/microsoft"
            app:icon="@drawable/ic_microsoft"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>
</LinearLayout>
