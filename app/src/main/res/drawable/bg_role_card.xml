<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#221E63D6">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_card" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/met_navy"
                        android:startColor="@color/met_royal" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/radius_card" />
                    <solid android:color="@color/met_card" />
                    <stroke android:width="1dp" android:color="@color/met_field_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
